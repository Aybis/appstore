# React Native / Expo resolve native modules and several runtime imports by
# walking a flat node_modules tree. pnpm's default isolated layout hides those
# undeclared-but-required packages (@expo/metro-runtime -> whatwg-fetch, and the
# autolinking lookups), so Metro fails to resolve them.
# Hoisting is the layout Expo documents for pnpm monorepos.
node-linker=hoisted
