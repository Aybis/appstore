# Copy to .env at the repo root, fill the empty values, then: chmod 600 .env
#   cp deploy/server.env.example .env
# .env is gitignored. Never commit it or paste it anywhere.

NODE_ENV=production
PORT=3000

# Supabase pooler (Supavisor transaction mode), port 6543, NOT the direct 5432 URL.
DATABASE_URL=

# Signs auth tokens. At least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=

# Artifact storage backend: Cloudflare R2 through the S3 adapter.
BLOB_STORE=s3
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# R2 wants "auto".
S3_REGION=auto
# R2 bucket name.
S3_BUCKET=
# R2 API token access key (Object Read & Write).
S3_ACCESS_KEY_ID=
# R2 API token secret.
S3_SECRET_ACCESS_KEY=

# One proxy (Caddy) in front: needed for real client IPs and https:// manifests.
TRUST_PROXY=1
COOKIE_SECURE=true
# Public origin of this API.
PUBLIC_BASE_URL=https://maya-api.muchtar.dev
# Console origin allowed to call the API from a browser.
CORS_ORIGINS=https://maya-store.muchtar.dev
# Where the install QR code points.
PORTAL_URL=https://maya-store.muchtar.dev
