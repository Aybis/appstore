# Template for .env.production.local at the repo root — the credentials the
# hosted deployment needs. Copy it, fill it in, and never commit the copy:
#
#   cp deploy/env.production.example .env.production.local
#
# .gitignore already covers `.env.*.local`.

# --- Supabase -----------------------------------------------------------------
# Dashboard > Settings > Database > Database password.
SUPABASE_DB_PASSWORD=

# --- Cloudflare R2 ------------------------------------------------------------
# Dashboard > R2 > Overview: the Account ID is on the right-hand side.
R2_ACCOUNT_ID=
R2_BUCKET=maya-artifacts
# R2 > Manage API tokens > Create API token, permission "Object Read & Write",
# scoped to the bucket above. Copy both values; the secret is shown once.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Render -------------------------------------------------------------------
# Account Settings > API Keys > Create API Key.
RENDER_API_KEY=
