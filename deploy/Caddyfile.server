# TLS termination for the API on this server. The console lives on Vercel.
# Caddy obtains and renews the Let's Encrypt certificate on its own.
maya-api.muchtar.dev {
	reverse_proxy api:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}

		# An APK is ~100 MB and a slow phone is not a failure.
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}

	request_body {
		max_size 512MB
	}
}
