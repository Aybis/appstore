# Template for the env files at the repo root. API, console and mobile all
# read the same file:
#
#   cp .env.example .env               development (local Postgres, dev bucket)
#   cp .env.example .env.production    production values, for the jobs you run
#                                      from your Mac: pnpm db:migrate:prod,
#                                      pnpm storage:tidy:prod
#
# Both are gitignored. Never commit them or paste them anywhere.
#
# The values below run everything on your own machine. The "PRODUCTION" notes
# in each block say what changes for .env.production and on the Tencent
# server, where the file is .env at the repo root and Docker Compose reads it.

# =============================================================================
# API  (apps/api)
# =============================================================================
# PRODUCTION: NODE_ENV=production
NODE_ENV=development
PORT=3000

# --- Database ----------------------------------------------------------------
# Local PostgreSQL 17 on port 5433, created by `pnpm db:setup`.
#
# The API connects AS app_runtime, a role that cannot bypass row-level
# security. Never point DATABASE_URL at a superuser: a superuser bypasses every
# RLS policy, so tenant isolation would silently vanish while tests passed.
#
# PRODUCTION (Supabase): DATABASE_URL is the POOLER url, port 6543:
#   postgres://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://app_runtime:devpassword@localhost:5433/appstore

# Migrations run as the role that OWNS the schema (app_runtime has no CREATE
# privilege). Locally that is your OS user.
#
# PRODUCTION (Supabase): port 5432, never the 6543 transaction pooler. Either
# the SESSION pooler (IPv4, works from any network):
#   postgres://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
# or the direct host (IPv6 only on most plans):
#   postgres://postgres:<PASSWORD>@db.<REF>.supabase.co:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgres://localhost:5433/appstore

# Integration tests create and drop scratch schemas in this database.
TEST_DATABASE_URL=postgres://app_runtime:devpassword@localhost:5433/appstore_test
TEST_MIGRATION_DATABASE_URL=postgres://localhost:5433/appstore_test

# --- File storage (APK/IPA builds, icons) ------------------------------------
# fs = local disk (./store), no extra service needed.
# DEV on R2: BLOB_STORE=s3 with S3_BUCKET=maya-artifacts-dev and a token
# scoped to that bucket only, so nothing you run locally can reach prod files.
# PRODUCTION: BLOB_STORE=s3 with Cloudflare R2, S3_BUCKET=maya-artifacts:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=<bucket>, keys from R2 > Manage API tokens (Object Read & Write)
BLOB_STORE=fs
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=artifacts
# Unused while BLOB_STORE=fs, but must not be empty: the API validates them.
S3_ACCESS_KEY_ID=dev-unused
S3_SECRET_ACCESS_KEY=dev-unused
S3_FORCE_PATH_STYLE=true

# --- Auth --------------------------------------------------------------------
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters-before-running

# --- Web access --------------------------------------------------------------
# Browser origins allowed to call the API, comma-separated, no wildcard.
# PRODUCTION: CORS_ORIGINS=https://maya-store.muchtar.dev
CORS_ORIGINS=http://localhost:5173

# PRODUCTION only — Caddy terminates TLS in front of the API:
#   TRUST_PROXY=1
#   COOKIE_SECURE=true
#   PUBLIC_BASE_URL=https://maya-api.muchtar.dev
#   PORTAL_URL=https://maya-store.muchtar.dev

# Where an app deep link points. The custom scheme only works once MAYA is
# installed; an https origin you control opens the website otherwise.
DEEP_LINK_BASE=maya://app


# =============================================================================
# CONSOLE  (apps/console)
# =============================================================================
# Only VITE_-prefixed values reach the browser; everything above stays server-side.
#
# Unset: the API on this page's host, port 3000 (right for local dev).
# On Vercel set VITE_API_BASE_URL=/ so calls go through the vercel.json rewrites.
# VITE_API_BASE_URL=/
VITE_ORG_SLUG=maya

# Optional: proxy /v1, /download and /health to a remote API while running
# the console locally, e.g. DEV_API_PROXY=https://maya-api.muchtar.dev
# (then uncomment VITE_API_BASE_URL=/ above as well).
DEV_API_PROXY=

# =============================================================================
# MOBILE  (apps/mobile)
# =============================================================================
# Read at BUILD time by app.config.js — change it, then rebuild the app.
#
# Not localhost: on the Android emulator "localhost" is the emulator itself.
# Use your machine's LAN IP:
#   ipconfig getifaddr "$(route -n get default | awk '/interface:/{print $2}')"
# Empty = the hosted API from app.json (https://maya-api.muchtar.dev).
MAYA_API_URL=
MAYA_ORG_SLUG=maya
# true = run on built-in demo data, no API needed.
MAYA_USE_MOCK_DATA=false

# =============================================================================
# SENTRY  (errors + performance, all three sides)
# =============================================================================
# Every value is optional. A DSN only says where events go, so it is not a
# secret; SENTRY_AUTH_TOKEN is.

# --- API ---------------------------------------------------------------------
# Empty = Sentry off (local runs and tests send nothing).
# PRODUCTION: the DSN of the API project in Sentry.
SENTRY_DSN=
# Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
# Tags events with a build, e.g. the git commit. Empty = untagged.
SENTRY_RELEASE=
# 0.0 to 1.0: the share of requests traced / profiled.
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILE_SAMPLE_RATE=1.0

# --- Console -----------------------------------------------------------------
# Empty = the built-in maya-console DSN in production builds, off in dev.
VITE_SENTRY_DSN=
# Defaults to the Vite mode (development / production).
VITE_SENTRY_ENVIRONMENT=

# --- Mobile ------------------------------------------------------------------
# Empty = the built-in react-native project DSN. Release builds only send.
MAYA_SENTRY_DSN=

# --- Source maps (build time) ------------------------------------------------
# Lets the Vercel build (console) and EAS build (mobile) upload source maps so
# stack traces show real file names. SECRET: set it in the Vercel and EAS
# project settings; put it here only to upload from a build on your machine.
# Empty = no upload, the build still succeeds.
# The org and projects are already configured: apps/console/vite.config.ts
# and the @sentry/react-native plugin in apps/mobile/app.json.
SENTRY_AUTH_TOKEN=
