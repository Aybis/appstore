# Copy to .env and adjust. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Two connection URLs, not one. DATABASE_URL is what the app uses at runtime;
# DIRECT_URL is what migrations use. They are identical locally and MUST differ
# on Supabase — see the Supabase block below for why.

NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# LOCAL POSTGRES (default: matches ./infra/local/setup.sh)
# ---------------------------------------------------------------------------
# The app connects AS app_runtime, a LOGIN role with rolbypassrls = false.
# Never point DATABASE_URL at your superuser account: a superuser bypasses every
# RLS policy, so tenant isolation would silently vanish while all tests passed.
DATABASE_URL=postgres://app_runtime:devpassword@localhost:5432/appstore
DIRECT_URL=postgres://app_runtime:devpassword@localhost:5432/appstore

# Migrations run as the role that OWNS the schema, not as app_runtime
# (app_runtime deliberately has no CREATE privilege). Default is your OS user.
MIGRATION_DATABASE_URL=postgres://localhost:5432/appstore

# Integration tests create and drop scratch schemas in this database.
TEST_DATABASE_URL=postgres://app_runtime:devpassword@localhost:5432/appstore_test
TEST_MIGRATION_DATABASE_URL=postgres://localhost:5432/appstore_test

# ---------------------------------------------------------------------------
# SUPABASE (uncomment to target a Supabase project instead)
# ---------------------------------------------------------------------------
# Fill <REF> with your project ref and <PASSWORD> with the database password
# from Dashboard > Settings > Database. <REGION> looks like ap-southeast-1.
#
# WHY TWO URLS:
#   Runtime uses Supavisor TRANSACTION mode (port 6543). Transaction pooling
#   returns the connection to the pool at COMMIT, which is exactly why
#   withTenant() sets everything with SET LOCAL / set_config(..., true) — those
#   unwind at COMMIT and cannot leak to the next borrower.
#
#   Migrations must NOT use 6543. DDL, advisory locks, and multi-statement
#   transactions need a stable session, so migrations use the direct connection.
#
# DATABASE_URL=postgres://postgres.<REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
# DIRECT_URL=postgres://postgres:<PASSWORD>@db.<REF>.supabase.co:5432/postgres?sslmode=require
# MIGRATION_DATABASE_URL=postgres://postgres:<PASSWORD>@db.<REF>.supabase.co:5432/postgres?sslmode=require
#
# Prepared statements must stay off in transaction mode. src/db/client.ts already
# passes { prepare: false } to postgres.js, so no extra setting is needed here.
#
# ⚠️ On Supabase you connect as `postgres`, which has rolbypassrls = true
#    (verified against PostgreSQL 17.6 on 2026-08-12). RLS protects nothing
#    until withTenant() issues SET LOCAL ROLE app_runtime. Run
#    infra/supabase/bootstrap.sql once per project to create that role.

# ---------------------------------------------------------------------------
# OBJECT STORAGE
# ---------------------------------------------------------------------------
# Local development uses the filesystem adapter — no Docker, no MinIO needed.
# Set BLOB_STORE=s3 to exercise the S3 adapter against Supabase Storage or AWS.
BLOB_STORE=fs
BLOB_FS_ROOT=./.data/artifacts

# S3 / Supabase Storage (used when BLOB_STORE=s3)
# Supabase: endpoint is https://<REF>.storage.supabase.co/storage/v1/s3
#           region must match your project region exactly
#           credentials are S3 access keys from Dashboard > Storage > S3 Access Keys,
#           NOT the service_role JWT
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# AUTH
# ---------------------------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters-before-running
