{
  "name": "appstore",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @appstore/api dev",
    "dev:console": "pnpm --filter @appstore/console dev",
    "dev:mobile": "pnpm --filter @appstore/mobile start",
    "db:setup": "pnpm --filter @appstore/api db:setup",
    "db:migrate": "pnpm --filter @appstore/api db:migrate",
    "db:seed": "pnpm --filter @appstore/api db:seed",
    "db:migrate:prod": "ENV_FILE=.env.production pnpm --filter @appstore/api db:migrate",
    "storage:tidy": "pnpm --filter @appstore/api storage:tidy",
    "storage:tidy:prod": "ENV_FILE=.env.production pnpm --filter @appstore/api storage:tidy",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^2.4.0",
      "compression": "^1.8.2",
      "esbuild": ">=0.25.0",
      "fast-uri": "^3.1.6",
      "js-yaml": "^4.3.2",
      "multer": "^2.3.0",
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.0",
      "shell-quote": "^1.11.0",
      "source-map-js": "^1.2.2",
      "uuid": ">=11.1.1",
      "vite": "^6.4.4"
    }
  }
}
