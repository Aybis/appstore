{
  "name": "@appstore/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "db:setup": "./database/setup-local.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-demo.ts",
    "db:seed:member": "tsx scripts/seed-member.ts",
    "db:seed:telemetry": "tsx scripts/seed-telemetry.ts",
    "ingest": "tsx scripts/ingest-binaries.ts",
    "prune": "tsx scripts/prune-store.ts",
    "publish:client": "tsx scripts/publish-client-build.ts"
  },
  "dependencies": {
    "@appstore/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/nestjs": "11.8.0",
    "@sentry/profiling-node": "11.8.0",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "nestjs-zod": "^4.0.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.7.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.2.7"
  }
}
